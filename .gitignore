# --- Obsidian ---
# 提交 .obsidian 让插件/设置/主题跨设备同步，但排除每台设备独有、易冲突的缓存
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.obsidian/plugins/**/data.json

# 回收站
.trash/

# --- 临时/导入暂存 ---
tmp/
_import/

# --- Claude Code ---
# 覆盖全局 ~/.config/git/ignore，让本仓库保留提交本地权限配置
!**/.claude/settings.local.json

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# MCP 配置（含 API token，勿提交）—— 三工具各自独立格式
.mcp.json
.codex/config.toml
.agents/mcp_config.json

# Python 缓存
__pycache__/
