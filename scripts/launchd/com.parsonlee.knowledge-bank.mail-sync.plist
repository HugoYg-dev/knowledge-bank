<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.parsonlee.knowledge-bank.mail-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>__UV_PATH__</string>
    <string>run</string>
    <string>--offline</string>
    <string>scripts/mail_pipeline.py</string>
    <string>run</string>
    <string>--fetch-web</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__VAULT_PATH__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    <key>GWS_BIN</key>
    <string>__GWS_PATH__</string>
    <key>GWS_TIMEOUT_SECONDS</key>
    <string>45</string>
    <key>HTTP_PROXY</key>
    <string>__HTTP_PROXY__</string>
    <key>HTTPS_PROXY</key>
    <string>__HTTPS_PROXY__</string>
    <key>ALL_PROXY</key>
    <string>__ALL_PROXY__</string>
    <key>http_proxy</key>
    <string>__HTTP_PROXY__</string>
    <key>https_proxy</key>
    <string>__HTTPS_PROXY__</string>
    <key>all_proxy</key>
    <string>__ALL_PROXY__</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Hour</key>
      <integer>9</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
    <dict>
      <key>Hour</key>
      <integer>21</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
  </array>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__VAULT_PATH__/Clippings/emails/.pipeline/logs/mail-sync.out.log</string>
  <key>StandardErrorPath</key>
  <string>__VAULT_PATH__/Clippings/emails/.pipeline/logs/mail-sync.err.log</string>
</dict>
</plist>
